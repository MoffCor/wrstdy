<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Name>WaterRateStudyTool</Name>
    <ProjectGuid>e963b0ff-a248-4ec4-ac8f-92a4de6404a1</ProjectGuid>
    <OutputPath>$(MSBuildThisFileDirectory)out\controls</OutputPath>
    <!-- The SDK otherwise appends the target framework (out\controls\net8.0)
         and the PCF build then rejects an outDir that doesn't match
         pcfconfig.json (pcf-1007). -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ExcludeDirectories Include="$(OutputPath)**" />
    <ExcludeDirectories Include=".gitignore" />
    <ExcludeDirectories Include="**\node_modules\**" />
    <!-- Build artifact of the root Vite library build; regenerated by the
         prebuild script and never checked in. -->
    <ExcludeDirectories Include="WaterRateStudyTool\app\**" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Pcf" Version="1.*" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" />

</Project>
